[Unit]
Description=Fusion-MOA v0.9.4.5 Gateway on AMD MT2 (candidate template)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/fusion-moa/versions/v0.9.4.5
Environment=FUSION_RUN_ID=amd-mt2-v0945-shared-evidence-candidate
Environment=FUSION_PORT=19018
Environment=FUSION_RUNS_DIR=/var/log/fusion-moa/v0.9.4.5/gateway
Environment=FUSION_TRACE_PATH=/var/log/fusion-moa/v0.9.4.5/gateway/traces/gateway.jsonl
Environment=V0945_ANALYST_CELLS=D16,D9,D13
Environment=V0945_PANEL_INTEGRATOR_CELL=D13
Environment=D12_BASE_URL=http://127.0.0.1:8001/v1
Environment=D16_BASE_URL=http://127.0.0.1:8002/v1
Environment=D9_BASE_URL=http://127.0.0.1:8004/v1
Environment=D13_BASE_URL=http://127.0.0.1:8006/v1
Environment=V0945_D12_MODEL=Qwen/Qwen3.8-27B
Environment=V0945_D16_MODEL=fusion-moa-d16-kat-coder-v2.5-dev
Environment=V0945_D9_MODEL=TeichAI/Qwen3.6-27B-Fable-5-v1
Environment=V0945_D13_MODEL=Jackrong/Qwopus3.6-35B-A3B-v1
Environment=V0945_EXECUTOR_TIMEOUT_SECONDS=6900
Environment=V0945_EXECUTOR_MAX_TOKENS=16384
Environment=V0945_OUTPUT_RECOVERY_MAX_TOKENS=512
Environment=V0945_ANALYST_DEADLINE_SECONDS=120
Environment=V0945_ANALYST_MAX_TOKENS=768
ExecStart=/opt/fusion-moa/venv/bin/python /opt/fusion-moa/versions/v0.9.4.5/fusion_terminal_server_v0945.py
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
